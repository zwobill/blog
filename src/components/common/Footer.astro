---
import { SITE } from '@/config/site';
import { Rss, FileText, Bot, ArrowUpRight } from '@lucide/astro';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200/80 bg-slate-50/50 py-12 transition-colors dark:border-slate-800/80 dark:bg-slate-950/40">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Col 1: Branding -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3">
          <img
            src="/bill-zuo.jpg"
            alt="Bill Zuo"
            class="h-10 w-10 rounded-full border border-slate-300 object-cover dark:border-slate-700"
          />
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-slate-100">
              {SITE.name}
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              Founder & CEO at <a href="https://softprobe.ai" target="_blank" rel="noopener noreferrer" class="font-medium text-sky-600 hover:underline dark:text-sky-400">Softprobe</a>
            </p>
          </div>
        </div>
        <p class="mt-3.5 max-w-sm text-xs leading-relaxed text-slate-600 dark:text-slate-400">
          20+ years architecting scalable AI-driven systems. Focused on runtime context, agent QA, DuckLake telemetry, and escaping the 200x observability indexing tax.
        </p>
        <p class="mt-2 text-xs text-slate-400">
          Los Altos, California
        </p>
      </div>

      <!-- Col 2: Navigation & Topics -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Explore
        </h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/blog" class="text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              All Articles
            </a>
          </li>
          <li>
            <a href="/tags/agent-qa" class="text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              Agent QA
            </a>
          </li>
          <li>
            <a href="/tags/observability" class="text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              Observability
            </a>
          </li>
          <li>
            <a href="/tags/geo" class="text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              GEO & AI Search
            </a>
          </li>
          <li>
            <a href="/about" class="text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              About & Experience
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Machine & Feeds -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          AI & Syndication
        </h4>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a href="/rss.xml" class="flex items-center gap-1.5 text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              <Rss class="h-3.5 w-3.5 text-amber-500" />
              <span>RSS 2.0 Feed</span>
            </a>
          </li>
          <li>
            <a href="/llms.txt" class="flex items-center gap-1.5 text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              <Bot class="h-3.5 w-3.5 text-sky-500" />
              <span>/llms.txt (AI Index)</span>
            </a>
          </li>
          <li>
            <a href="/llms-full.txt" class="flex items-center gap-1.5 text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              <FileText class="h-3.5 w-3.5 text-emerald-500" />
              <span>/llms-full.txt</span>
            </a>
          </li>
          <li>
            <a href="/sitemap-index.xml" class="text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400">
              XML Sitemap
            </a>
          </li>
        </ul>

        <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
          <div class="flex items-center gap-3 text-slate-500 dark:text-slate-400">
            <a
              href={SITE.author.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400"
              aria-label="LinkedIn Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.53 1.53 0 0 0 1.53-1.53 1.53 1.53 0 0 0-1.53-1.54 1.53 1.53 0 0 0-1.54 1.54 1.53 1.53 0 0 0 1.54 1.53m1.39 9.74v-8.37H5.07v8.37z"/></svg>
            </a>
            <a
              href={SITE.author.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400"
              aria-label="X Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a
              href={SITE.author.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400"
              aria-label="GitHub Profile"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-200/80 pt-6 text-xs text-slate-500 sm:flex-row dark:border-slate-800/80 dark:text-slate-400">
      <div>
        © {year} {SITE.author.name}. All rights reserved.
      </div>
      <div class="flex items-center gap-2 text-slate-400">
        <span>Static on Cloudflare Edge</span>
        <span>•</span>
        <span>Powered by Astro</span>
      </div>
    </div>
  </div>
</footer>
