---
import { Sparkles, CheckCircle2 } from '@lucide/astro';

export interface Props {
  title?: string;
  items?: string[];
}

const { title = 'Key Takeaways & Executive Summary', items = [] } = Astro.props;
---

<div
  id="key-takeaways"
  class="my-8 rounded-2xl border border-sky-200/80 bg-sky-50/60 p-6 shadow-xs backdrop-blur-xs transition-colors dark:border-sky-900/50 dark:bg-sky-950/20"
>
  <div class="mb-4 flex items-center gap-2.5">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-600/10 text-sky-700 dark:bg-sky-400/10 dark:text-sky-300">
      <Sparkles class="h-4 w-4" />
    </div>
    <h3 class="text-base font-bold tracking-tight text-slate-900 dark:text-slate-100">
      {title}
    </h3>
  </div>

  {items.length > 0 ? (
    <ul class="space-y-2.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      {items.map((item) => (
        <li class="flex items-start gap-2.5">
          <CheckCircle2 class="mt-0.5 h-4 w-4 shrink-0 text-sky-600 dark:text-sky-400" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  ) : (
    <div class="text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <slot />
    </div>
  )}
</div>
