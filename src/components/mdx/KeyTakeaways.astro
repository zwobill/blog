---
export interface Props {
  title?: string;
  items?: string[];
}

const { title = 'Key Takeaways & Executive Summary', items = [] } = Astro.props;
---

<div
  id="key-takeaways"
  class="my-8 rounded-2xl border border-slate-200 bg-slate-50/70 p-6 shadow-2xs transition-colors dark:border-slate-800 dark:bg-slate-900/40"
>
  <div class="mb-4">
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200">
      {title}
    </h3>
  </div>

  {items.length > 0 ? (
    <ul class="space-y-2.5 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      {items.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  ) : (
    <div class="text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      <slot />
    </div>
  )}
</div>
