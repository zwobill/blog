---
import { Copy, Check } from '@lucide/astro';

export interface Props {
  filename?: string;
  lang?: string;
}

const { filename, lang } = Astro.props;
---

<div class="code-block-wrapper group relative my-6 overflow-hidden rounded-xl border border-slate-200 bg-slate-950 dark:border-slate-800">
  {(filename || lang) && (
    <div class="flex items-center justify-between border-b border-slate-800 bg-slate-900/80 px-4 py-2 text-xs font-mono text-slate-400">
      <div class="flex items-center gap-2">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-red-500/80"></span>
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
        {filename && <span class="ml-2 font-medium text-slate-300">{filename}</span>}
      </div>
      {lang && <span class="uppercase tracking-wider text-slate-500">{lang}</span>}
    </div>
  )}

  <div class="relative">
    <button
      type="button"
      class="copy-code-btn absolute right-3 top-3 z-10 flex h-8 w-8 items-center justify-center rounded-md border border-slate-700/80 bg-slate-800/90 text-slate-300 opacity-0 shadow-sm transition-all duration-200 hover:bg-slate-700 hover:text-white group-hover:opacity-100 focus:opacity-100"
      aria-label="Copy code to clipboard"
    >
      <Copy class="copy-icon h-4 w-4" />
      <Check class="check-icon hidden h-4 w-4 text-emerald-400" />
    </button>
    <div class="overflow-x-auto p-4 text-sm leading-relaxed text-slate-200">
      <slot />
    </div>
  </div>
</div>

<script>
  function setupCodeCopy() {
    const wrappers = document.querySelectorAll('.code-block-wrapper');
    wrappers.forEach((wrapper) => {
      const btn = wrapper.querySelector('.copy-code-btn');
      const copyIcon = wrapper.querySelector('.copy-icon');
      const checkIcon = wrapper.querySelector('.check-icon');

      if (!btn) return;

      btn.addEventListener('click', async () => {
        const pre = wrapper.querySelector('pre') || wrapper.querySelector('code');
        const codeText = pre ? pre.innerText : '';
        if (!codeText) return;

        try {
          await navigator.clipboard.writeText(codeText.trim());
          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
            setTimeout(() => {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });
    });
  }

  setupCodeCopy();
  document.addEventListener('astro:page-load', setupCodeCopy);
</script>
