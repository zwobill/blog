---
import { ChevronDown, HelpCircle } from '@lucide/astro';

export interface Props {
  title?: string;
  items?: Array<{ question: string; answer: string }>;
}

const { title = 'Frequently Asked Questions', items = [] } = Astro.props;
---

<div class="my-10 rounded-2xl border border-slate-200 bg-slate-50/50 p-6 dark:border-slate-800 dark:bg-slate-900/30">
  <div class="mb-5 flex items-center gap-2.5">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400">
      <HelpCircle class="h-4 w-4" />
    </div>
    <h3 class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100">
      {title}
    </h3>
  </div>

  <div class="divide-y divide-slate-200 dark:divide-slate-800">
    {items.map((item, index) => (
      <details class="group py-3.5 first:pt-0 last:pb-0">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-800 transition-colors hover:text-sky-600 dark:text-slate-200 dark:hover:text-sky-400">
          <span class="text-sm md:text-base">{item.question}</span>
          <span class="ml-2 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-slate-400 transition-transform duration-200 group-open:rotate-180 dark:text-slate-500">
            <ChevronDown class="h-4 w-4" />
          </span>
        </summary>
        <div class="mt-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {item.answer}
        </div>
      </details>
    ))}
  </div>
</div>
