---
import { Info, AlertTriangle, AlertCircle, Lightbulb, CheckCircle2 } from '@lucide/astro';

export interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger' | 'info';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const styles = {
  note: {
    container: 'border-slate-300 bg-slate-50 text-slate-800 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-200',
    iconBg: 'bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
    titleColor: 'text-slate-900 dark:text-slate-100',
    icon: Info,
    defaultTitle: 'Note',
  },
  tip: {
    container: 'border-emerald-300 bg-emerald-50/80 text-emerald-900 dark:border-emerald-800/60 dark:bg-emerald-950/20 dark:text-emerald-200',
    iconBg: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
    titleColor: 'text-emerald-950 dark:text-emerald-100',
    icon: Lightbulb,
    defaultTitle: 'Pro Tip',
  },
  info: {
    container: 'border-sky-300 bg-sky-50/80 text-sky-900 dark:border-sky-800/60 dark:bg-sky-950/20 dark:text-sky-200',
    iconBg: 'bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300',
    titleColor: 'text-sky-950 dark:text-sky-100',
    icon: Info,
    defaultTitle: 'Information',
  },
  warning: {
    container: 'border-amber-300 bg-amber-50/80 text-amber-900 dark:border-amber-800/60 dark:bg-amber-950/20 dark:text-amber-200',
    iconBg: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
    titleColor: 'text-amber-950 dark:text-amber-100',
    icon: AlertTriangle,
    defaultTitle: 'Warning',
  },
  danger: {
    container: 'border-rose-300 bg-rose-50/80 text-rose-900 dark:border-rose-800/60 dark:bg-rose-950/20 dark:text-rose-200',
    iconBg: 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300',
    titleColor: 'text-rose-950 dark:text-rose-100',
    icon: AlertCircle,
    defaultTitle: 'Caution',
  },
};

const current = styles[type] || styles.note;
const IconComponent = current.icon;
const displayTitle = title || current.defaultTitle;
---

<div class={`my-6 rounded-xl border p-4.5 shadow-2xs transition-colors ${current.container}`}>
  <div class="flex items-start gap-3">
    <div class={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md ${current.iconBg}`}>
      <IconComponent class="h-3.5 w-3.5" />
    </div>
    <div class="min-w-0 flex-1">
      {displayTitle && (
        <h4 class={`mb-1 text-sm font-semibold tracking-tight ${current.titleColor}`}>
          {displayTitle}
        </h4>
      )}
      <div class="text-sm leading-relaxed opacity-95">
        <slot />
      </div>
    </div>
  </div>
</div>
