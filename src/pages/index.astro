---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight, Sparkles, Calendar, Clock, Rss, Bot, ShieldCheck } from '@lucide/astro';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = allPosts.find((p) => p.data.featured) || allPosts[0];
const recentPosts = allPosts.filter((p) => p.id !== featuredPost?.id);
---

<BaseLayout
  title={`${SITE.author.name} — AI Context, Distributed Systems & Agent QA`}
  description={SITE.description}
  type="website"
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <!-- Hero Section -->
    <section class="mb-16 rounded-3xl border border-slate-200/90 bg-gradient-to-br from-slate-50 via-white to-sky-50/40 p-8 shadow-xs sm:p-12 dark:border-slate-800/90 dark:from-slate-900/60 dark:via-[#090d16] dark:to-sky-950/20">
      <div class="flex flex-col-reverse items-center justify-between gap-8 md:flex-row md:items-start">
        <div class="max-w-2xl text-center md:text-left">
          <!-- Authority Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-sky-200 bg-sky-50 px-3.5 py-1 text-xs font-semibold text-sky-800 dark:border-sky-800 dark:bg-sky-950/60 dark:text-sky-300">
            <span class="inline-block h-2 w-2 rounded-full bg-sky-500 animate-pulse"></span>
            <span>Founder & CEO at Softprobe</span>
          </div>

          <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-50">
            Bill Zuo
          </h1>

          <p class="mt-3 text-lg font-medium text-sky-600 dark:text-sky-400">
            Distributed Systems • AI Runtime Context • Agent QA • DuckLake Telemetry
          </p>

          <p class="mt-4 text-base leading-relaxed text-slate-600 dark:text-slate-300">
            20+ years architecting scalable AI-driven infrastructure. Building <a href="https://softprobe.ai" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-900 underline decoration-sky-500 decoration-2 underline-offset-2 dark:text-white">Softprobe</a> to eliminate the 200x observability "indexing tax" and provide forever-cheap runtime evidence for AI agents.
          </p>

          <!-- Social Proof & Links -->
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3 md:justify-start">
            <a
              href={SITE.author.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:border-sky-300 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-sky-800 dark:hover:text-sky-400"
            >
              <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.53 1.53 0 0 0 1.53-1.53 1.53 1.53 0 0 0-1.53-1.54 1.53 1.53 0 0 0-1.54 1.54 1.53 1.53 0 0 0 1.54 1.53m1.39 9.74v-8.37H5.07v8.37z"/></svg>
              <span>LinkedIn /yunfeizuo</span>
            </a>

            <a
              href={SITE.author.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:border-sky-300 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-sky-800 dark:hover:text-sky-400"
            >
              <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span>X @billzwo</span>
            </a>

            <a
              href={SITE.author.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-2xs transition-colors hover:border-sky-300 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-sky-800 dark:hover:text-sky-400"
            >
              <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
              <span>GitHub zwobill</span>
            </a>
          </div>
        </div>

        <!-- Headshot Image with subtle ring -->
        <div class="relative shrink-0">
          <div class="absolute -inset-1.5 rounded-full bg-gradient-to-r from-sky-400 to-blue-600 opacity-30 blur-sm"></div>
          <img
            src="/bill-zuo.jpg"
            alt="Bill Zuo"
            class="relative h-32 w-32 rounded-full border-4 border-white object-cover shadow-xl sm:h-40 sm:w-40 dark:border-slate-800"
          />
        </div>
      </div>
    </section>

    <!-- Featured Post -->
    {featuredPost && (
      <section class="mb-16">
        <div class="mb-6 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Sparkles class="h-4 w-4 text-sky-600 dark:text-sky-400" />
            <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
              Featured Deep Dive
            </h2>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
            Latest Engineering Note
          </span>
        </div>

        <a
          href={`/blog/${featuredPost.id.replace(/\.(md|mdx)$/, '')}`}
          class="group block rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs transition-all duration-200 hover:border-sky-300 hover:shadow-md sm:p-8 dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-sky-800"
        >
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
            <span class="rounded-full bg-sky-100 px-2.5 py-0.5 font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
              {featuredPost.data.category}
            </span>
            <div class="flex items-center gap-1">
              <Calendar class="h-3 w-3" />
              <span>{featuredPost.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
            <span>•</span>
            <span>{featuredPost.data.author}</span>
          </div>

          <h3 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 group-hover:text-sky-600 sm:text-3xl dark:text-slate-100 dark:group-hover:text-sky-400">
            {featuredPost.data.title}
          </h3>

          <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">
            {featuredPost.data.description}
          </p>

          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-sky-600 dark:text-sky-400">
            <span>Read full article</span>
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </div>
        </a>
      </section>
    )}

    <!-- Recent Articles List -->
    <section class="mb-16">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
          Recent Articles
        </h2>
        <a
          href="/blog"
          class="flex items-center gap-1 text-sm font-medium text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
        >
          <span>View all ({allPosts.length})</span>
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>

      <div class="divide-y divide-slate-200 dark:divide-slate-800">
        {allPosts.map((post) => {
          const slug = post.id.replace(/\.(md|mdx)$/, '');
          return (
            <article class="group py-6 first:pt-0 last:pb-0">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-sky-600 dark:text-sky-400">{post.data.category}</span>
                  <span>•</span>
                  <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </div>
                <div class="flex items-center gap-2">
                  {post.data.tags.slice(0, 3).map((t) => (
                    <span class="rounded-sm bg-slate-100 px-1.5 py-0.5 text-[11px] text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                      #{t}
                    </span>
                  ))}
                </div>
              </div>

              <h3 class="mt-2 text-xl font-bold tracking-tight text-slate-900 group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
                <a href={`/blog/${slug}`}>{post.data.title}</a>
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-slate-600 line-clamp-2 dark:text-slate-300">
                {post.data.description}
              </p>

              <div class="mt-3">
                <a
                  href={`/blog/${slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-sky-600 hover:underline dark:text-sky-400"
                >
                  <span>Read deep dive</span>
                  <ArrowRight class="h-3.5 w-3.5" />
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Core Topics Grid -->
    <section class="rounded-2xl border border-slate-200 bg-slate-50/50 p-8 dark:border-slate-800 dark:bg-slate-900/30">
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
        Topics & Architectural Domains
      </h2>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Selected research and engineering notes on modern agent systems.
      </p>

      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {SITE.topics.map((topic) => (
          <a
            href={`/tags/${topic.slug}`}
            class="group rounded-xl border border-slate-200 bg-white p-4 transition-all hover:border-sky-300 hover:shadow-xs dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-sky-800"
          >
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
              {topic.name}
            </h3>
            <p class="mt-1 text-xs text-slate-500 line-clamp-2 dark:text-slate-400">
              {topic.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
