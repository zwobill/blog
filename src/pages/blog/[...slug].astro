---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import KeyTakeaways from '@/components/mdx/KeyTakeaways.astro';
import Callout from '@/components/mdx/Callout.astro';
import FAQ from '@/components/mdx/FAQ.astro';
import YouTube from '@/components/mdx/YouTube.astro';
import Video from '@/components/mdx/Video.astro';
import Figure from '@/components/mdx/Figure.astro';
import Quote from '@/components/mdx/Quote.astro';
import CodeBlock from '@/components/mdx/CodeBlock.astro';
import getReadingTime from 'reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Calculate reading time and word count
const stats = getReadingTime(post.body || '');
const slug = post.id.replace(/\.(md|mdx)$/, '');
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  heroImage={post.data.heroImage}
  heroImageAlt={post.data.heroImageAlt}
  tags={post.data.tags}
  category={post.data.category}
  slug={slug}
  headings={headings}
  wordCount={stats.words}
  readingTime={stats.text}
  faq={post.data.faq}
>
  <Content
    components={{
      KeyTakeaways,
      Callout,
      FAQ,
      YouTube,
      Video,
      Figure,
      Quote,
      CodeBlock,
    }}
  />
</BlogPostLayout>
