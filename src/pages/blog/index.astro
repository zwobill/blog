---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { Calendar, Clock, Tag, ArrowRight } from '@lucide/astro';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags)));
---

<BaseLayout
  title={`Articles & Engineering Notes | ${SITE.name}`}
  description="Technical deep dives on agent QA, session graphs, DuckLake telemetry, and generative engine optimization."
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mb-10">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
        Articles & Engineering Notes
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-300">
        Architecture designs, telemetry store deep-dives, and production reflections from building Softprobe.
      </p>

      <!-- Topic Pills -->
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <a
          href="/blog"
          class="rounded-full bg-sky-600 px-3 py-1 text-xs font-semibold text-white dark:bg-sky-500"
        >
          All ({allPosts.length})
        </a>
        {allTags.map((tag) => (
          <a
            href={`/tags/${tag.toLowerCase()}`}
            class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-600 transition-colors hover:border-sky-300 hover:text-sky-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 dark:hover:border-sky-800 dark:hover:text-sky-400"
          >
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <!-- Post List -->
    <div class="divide-y divide-slate-200 border-t border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {allPosts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="group py-8">
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
              <span class="rounded-full bg-sky-100 px-2.5 py-0.5 font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                {post.data.category}
              </span>
              <div class="flex items-center gap-1">
                <Calendar class="h-3 w-3" />
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <span>•</span>
              <span>{post.data.author}</span>
            </div>

            <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
              <a href={`/blog/${slug}`}>{post.data.title}</a>
            </h2>

            <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">
              {post.data.description}
            </p>

            {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
              <div class="mt-4 rounded-lg bg-slate-50 p-3 text-xs text-slate-600 dark:bg-slate-900/60 dark:text-slate-400">
                <span class="font-semibold text-slate-800 dark:text-slate-200">Core finding:</span>{' '}
                {post.data.keyTakeaways[0]}
              </div>
            )}

            <div class="mt-5 flex items-center justify-between">
              <div class="flex flex-wrap items-center gap-1.5">
                {post.data.tags.map((t) => (
                  <span class="text-xs text-slate-400 dark:text-slate-500">#{t}</span>
                ))}
              </div>

              <a
                href={`/blog/${slug}`}
                class="inline-flex items-center gap-1 text-sm font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
              >
                <span>Read article</span>
                <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
