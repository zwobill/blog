---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowLeft, Home, Search } from '@lucide/astro';
---

<BaseLayout
  title="404 — Page Not Found | Bill Zuo"
  description="The page you requested could not be found."
>
  <div class="mx-auto flex max-w-2xl flex-col items-center justify-center px-4 py-24 text-center sm:px-6 lg:px-8">
    <div class="rounded-full bg-sky-100 p-4 text-sky-600 dark:bg-sky-950/60 dark:text-sky-400">
      <span class="text-3xl font-black">404</span>
    </div>

    <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
      Page Not Found
    </h1>

    <p class="mt-3 text-base text-slate-600 dark:text-slate-400">
      The article or page you are looking for has been moved, renamed, or is unavailable.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-sky-700 dark:bg-sky-500 dark:hover:bg-sky-600"
      >
        <Home class="h-4 w-4" />
        <span>Back to Home</span>
      </a>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-2xs transition-colors hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        <ArrowLeft class="h-4 w-4" />
        <span>Browse Articles</span>
      </a>
    </div>
  </div>
</BaseLayout>
