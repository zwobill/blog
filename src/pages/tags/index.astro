---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { Tag, Hash, ArrowRight } from '@lucide/astro';

const allPosts = (await getCollection('blog')).filter((post) => !post.data.draft);

// Count tags
const tagCounts = allPosts.reduce(
  (acc, post) => {
    post.data.tags.forEach((tag) => {
      const lower = tag.toLowerCase();
      acc[lower] = (acc[lower] || 0) + 1;
    });
    return acc;
  },
  {} as Record<string, number>
);

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title={`Topics & Tags | ${SITE.name}`}
  description="Browse all engineering topics, architectural categories, and research themes."
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10">
      <div class="flex items-center gap-2 text-sky-600 dark:text-sky-400">
        <Tag class="h-5 w-5" />
        <span class="text-xs font-semibold uppercase tracking-wider">Taxonomy</span>
      </div>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
        Topics & Architectural Domains
      </h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-300">
        Index of core subjects covering AI observability, agent testing, data engineering, and generative SEO.
      </p>
    </header>

    <!-- Curated Topics -->
    <section class="mb-12">
      <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">
        Core Domains
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {SITE.topics.map((t) => (
          <a
            href={`/tags/${t.slug}`}
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition-all hover:border-sky-300 hover:shadow-xs dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-sky-800"
          >
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900 group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
                {t.name}
              </h3>
              <ArrowRight class="h-4 w-4 text-slate-400 group-hover:translate-x-1 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-transform" />
            </div>
            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
              {t.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- All Tags List -->
    <section>
      <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">
        All Tags
      </h2>
      <div class="mt-4 flex flex-wrap gap-2.5">
        {sortedTags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}`}
            class="flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:border-sky-300 hover:bg-sky-50/50 hover:text-sky-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-sky-800 dark:hover:text-sky-400"
          >
            <Hash class="h-3.5 w-3.5 text-slate-400" />
            <span>{tag}</span>
            <span class="rounded-full bg-slate-200 px-1.5 py-0.2 text-[10px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
              {count}
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
