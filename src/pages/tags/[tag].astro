---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { getCollection } from 'astro:content';
import { Hash, Calendar, ArrowLeft, ArrowRight } from '@lucide/astro';

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const tags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags.map((t) => t.toLowerCase()))));

  return tags.map((tag) => {
    const filteredPosts = allPosts.filter((p) =>
      p.data.tags.some((t) => t.toLowerCase() === tag)
    );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

// Check if this tag matches one of our defined topics
const matchedTopic = SITE.topics.find((t) => t.slug === tag || t.name.toLowerCase() === tag);
---

<BaseLayout
  title={`#${tag} Articles | ${SITE.name}`}
  description={matchedTopic?.description || `Explore engineering articles and deep dives tagged with #${tag}.`}
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <nav class="mb-8">
      <a
        href="/tags"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
      >
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>All Topics</span>
      </a>
    </nav>

    <header class="mb-10 border-b border-slate-200/80 pb-8 dark:border-slate-800/80">
      <div class="flex items-center gap-2 text-sky-600 dark:text-sky-400">
        <Hash class="h-6 w-6" />
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
          {matchedTopic?.name || tag}
        </h1>
      </div>
      <p class="mt-3 text-base text-slate-600 dark:text-slate-300">
        {matchedTopic?.description || `Engineering notes, architectural guides, and findings tagged with #${tag}.`}
      </p>
      <div class="mt-2 text-xs font-medium text-slate-500">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} found
      </div>
    </header>

    <div class="divide-y divide-slate-200 dark:divide-slate-800">
      {posts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="group py-6 first:pt-0">
            <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
              <span class="rounded-full bg-sky-100 px-2.5 py-0.5 font-semibold text-sky-800 dark:bg-sky-950 dark:text-sky-300">
                {post.data.category}
              </span>
              <div class="flex items-center gap-1">
                <Calendar class="h-3 w-3" />
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>
            </div>

            <h2 class="mt-2.5 text-xl font-bold tracking-tight text-slate-900 group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
              <a href={`/blog/${slug}`}>{post.data.title}</a>
            </h2>

            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {post.data.description}
            </p>

            <div class="mt-4">
              <a
                href={`/blog/${slug}`}
                class="inline-flex items-center gap-1 text-xs font-semibold text-sky-600 hover:underline dark:text-sky-400"
              >
                <span>Read article</span>
                <ArrowRight class="h-3.5 w-3.5" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
