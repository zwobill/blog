---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '@/config/site';
import { Calendar, Clock, Tag, Share2, Copy, Check, ArrowLeft, ArrowUpRight, Bot } from '@lucide/astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  heroImage?: string;
  heroImageAlt?: string;
  tags?: string[];
  category?: string;
  slug: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  wordCount?: number;
  readingTime?: string;
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = SITE.author.name,
  heroImage,
  heroImageAlt,
  tags = [],
  category = 'Engineering',
  slug,
  headings = [],
  wordCount,
  readingTime = '5 min read',
  faq = [],
} = Astro.props;

const canonicalUrl = `${SITE.url}/blog/${slug}`;
const rawMdUrl = `/blog/${slug}.md`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Articles', url: '/blog' },
  { name: title, url: `/blog/${slug}` },
];

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Filter headings for table of contents (depth 2 and 3)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${title} | ${SITE.name}`}
  description={description}
  image={heroImage || SITE.defaultOgImage}
  type="article"
  articleDate={pubDate}
  articleModifiedDate={updatedDate}
  articleTags={tags}
  canonicalUrl={canonicalUrl}
  wordCount={wordCount}
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <!-- Breadcrumb Nav -->
    <nav class="mb-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-sky-600 dark:hover:text-sky-400">Articles</a>
      <span>/</span>
      <span class="truncate font-medium text-slate-700 dark:text-slate-300">{title}</span>
    </nav>

    <!-- Post Header -->
    <header class="mb-10 border-b border-slate-200/80 pb-8 dark:border-slate-800/80">
      <!-- Category & Metadata Badges -->
      <div class="mb-4 flex flex-wrap items-center gap-3 text-xs">
        <a
          href={`/tags/${category.toLowerCase()}`}
          class="rounded-full bg-sky-100 px-3 py-1 font-semibold text-sky-800 transition-colors hover:bg-sky-200 dark:bg-sky-950/60 dark:text-sky-300 dark:hover:bg-sky-900"
        >
          {category}
        </a>

        <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
          <Calendar class="h-3.5 w-3.5" />
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        </div>

        {updatedDate && (
          <div class="hidden items-center gap-1.5 text-slate-500 sm:flex dark:text-slate-400">
            <span>(Updated: <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>)</span>
          </div>
        )}

        <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
          <Clock class="h-3.5 w-3.5" />
          <span>{readingTime}</span>
        </div>

        {wordCount && (
          <div class="hidden text-slate-400 sm:inline dark:text-slate-500">
            • {wordCount} words
          </div>
        )}
      </div>

      <!-- Article Title -->
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-slate-50">
        {title}
      </h1>

      <!-- Article Subtitle / Lead -->
      <p class="article-lead mt-4 text-lg leading-relaxed text-slate-600 sm:text-xl dark:text-slate-300">
        {description}
      </p>

      <!-- Author Bar & Actions -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 pt-6 dark:border-slate-800/60">
        <div class="flex items-center gap-3">
          <a href="/about" class="group flex items-center gap-3">
            <img
              src="/bill-zuo.jpg"
              alt={author}
              class="h-11 w-11 rounded-full border border-slate-300 object-cover shadow-2xs group-hover:scale-105 transition-transform dark:border-slate-700"
            />
            <div>
              <div class="text-sm font-bold text-slate-900 group-hover:text-sky-600 dark:text-slate-100 dark:group-hover:text-sky-400">
                {author}
              </div>
              <div class="text-xs text-slate-500 dark:text-slate-400">
                Founder & CEO at <span class="font-medium text-slate-700 dark:text-slate-300">Softprobe</span>
              </div>
            </div>
          </a>
        </div>

        <!-- Share & Raw MD Action Buttons -->
        <div class="flex items-center gap-2">
          <!-- Raw Markdown link for AI / Readers -->
          <a
            href={rawMdUrl}
            target="_blank"
            class="flex h-9 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200"
            title="Read raw markdown (ideal for LLM context or copying)"
          >
            <Bot class="h-3.5 w-3.5 text-sky-500" />
            <span class="hidden sm:inline">Raw</span> Markdown
          </a>

          <!-- Copy URL button -->
          <button
            id="copy-article-url"
            type="button"
            class="flex h-9 items-center gap-1.5 rounded-lg border border-slate-200 px-3 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200"
            aria-label="Copy article URL"
          >
            <Copy class="copy-url-icon h-3.5 w-3.5" />
            <Check class="check-url-icon hidden h-3.5 w-3.5 text-emerald-500" />
            <span>Copy Link</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Optional Table of Contents for Long Articles -->
    {tocHeadings.length >= 3 && (
      <nav class="mb-10 rounded-xl border border-slate-200 bg-slate-50/60 p-5 dark:border-slate-800 dark:bg-slate-900/40" aria-label="Table of Contents">
        <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Table of Contents
        </h2>
        <ul class="space-y-1.5 text-sm">
          {tocHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'ml-4' : ''}>
              <a
                href={`#${heading.slug}`}
                class="text-slate-600 transition-colors hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Article Content -->
    <div class="prose prose-slate lg:prose-lg dark:prose-invert max-w-none prose-headings:scroll-mt-20 prose-headings:font-bold prose-headings:tracking-tight prose-a:font-medium prose-a:text-sky-600 dark:prose-a:text-sky-400 prose-img:rounded-xl">
      <slot />
    </div>

    <!-- Article Footer -->
    <footer class="mt-12 border-t border-slate-200/80 pt-8 dark:border-slate-800/80">
      <!-- Tag Pills -->
      {tags.length > 0 && (
        <div class="mb-8 flex flex-wrap items-center gap-2">
          <Tag class="h-4 w-4 text-slate-400" />
          <span class="text-xs font-medium text-slate-500">Tags:</span>
          {tags.map((tag) => (
            <a
              href={`/tags/${tag.toLowerCase()}`}
              class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 transition-colors hover:border-sky-300 hover:text-sky-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-sky-800 dark:hover:text-sky-400"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <!-- Author Bio Card (E-E-A-T Foundation) -->
      <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900/50">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
          <img
            src="/bill-zuo.jpg"
            alt="Bill Zuo"
            class="h-20 w-20 rounded-full border-2 border-white object-cover shadow-md dark:border-slate-800"
          />
          <div class="flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">
                  {SITE.author.name}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                  {SITE.author.role} • Los Altos, CA
                </p>
              </div>

              <!-- Author Links -->
              <div class="flex items-center gap-2">
                <a
                  href={SITE.author.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:text-sky-400"
                >
                  LinkedIn
                </a>
                <a
                  href={SITE.author.social.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-sky-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:text-sky-400"
                >
                  X @billzwo
                </a>
              </div>
            </div>

            <p class="mt-3 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
              {SITE.author.bio} Founder Institute graduate, building Softprobe to deliver 100x cost-effective agent QA and runtime session context.
            </p>
          </div>
        </div>
      </div>

      <!-- Back to articles link -->
      <div class="mt-8 flex items-center justify-between">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
        >
          <ArrowLeft class="h-4 w-4" />
          <span>Back to all articles</span>
        </a>

        <a
          href="/llms.txt"
          class="text-xs text-slate-400 hover:underline dark:text-slate-500"
        >
          Indexed in /llms.txt
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  function setupArticleCopy() {
    const copyBtn = document.getElementById('copy-article-url');
    if (!copyBtn) return;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const copyIcon = copyBtn.querySelector('.copy-url-icon');
        const checkIcon = copyBtn.querySelector('.check-url-icon');
        const textSpan = copyBtn.querySelector('span');

        if (copyIcon && checkIcon && textSpan) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          textSpan.textContent = 'Copied!';

          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            textSpan.textContent = 'Copy Link';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy link:', err);
      }
    });
  }

  setupArticleCopy();
  document.addEventListener('astro:page-load', setupArticleCopy);
</script>
